        "jsCode": "// Check if email arrived within 24h\nconst rawDate = $('when message received').first().json.internalDate || $('Edit Fields').first().json.received_at;\nconst lastTs = isNaN(Number(rawDate)) ? new Date(rawDate).getTime() : Number(rawDate);\nconst withinWindow = (Date.now() - lastTs) < 24 * 60 * 60 * 1000;\n\nreturn [{ json: { withinWindow, answer: $json.answer, userId: $json.userId } }];"
      },
