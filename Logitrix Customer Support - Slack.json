      "parameters": {
        "jsCode": "const text = ($('Edit Fields').first().json.message_text || '').toLowerCase();\nconst rows = $input.all().map(i => i.json);\n\nconst match = rows.find(r => {\n  const intent = String(r['User Intent'] || '').toLowerCase();\n  return intent && (text.includes(intent) || intent.includes(text));\n});\n\nreturn [{\n  json: {\n    ...$('Edit Fields').first().json,\n    answer: match ? match['Approved AI / FAQ Response'] : ''\n  }\n}];"
      },
