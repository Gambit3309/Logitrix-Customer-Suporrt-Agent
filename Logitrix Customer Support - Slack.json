      "parameters": {
        "jsCode": "const googleDocs = $input.all().map((item) => item.json);\nconst body = $('Edit Fields').first().json.message_text;\n\nconst date = new Date();\nconst formattedDate = `${date.getMonth() + 1} ${date.getDate()}, ${date.getFullYear()}`;\n\nfunction extractText(doc) {\n  const content = doc?.body?.content || [];\n  let text = '';\n  for (const el of content) {\n    const elements = el.paragraph?.elements || [];\n    for (const e of elements) {\n      if (e.textRun?.content) text += e.textRun.content;\n    }\n  }\n  return text;\n}\n\nconst docText = extractText(googleDocs[0]);\n\nconst finalPrompt = `Today's date is: ${formattedDate}\\n\\n${docText}\\n\\nUser's question:\\n${body}`;\n\nreturn { finalPrompt };"
      },
